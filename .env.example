# ===== Grok Studio 서버 설정 =====
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 커밋되지 않습니다)

# 서버 포트 (기본 5173)
PORT=5173

# --- 사진: 제미나이(Gemini) ---
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- 영상 provider 선택: kling | xai | gemini_veo ---
# 비워두면 영상은 데모 모드로 동작합니다.
VIDEO_PROVIDER=kling

# (VIDEO_PROVIDER=kling 일 때) 클링 영상 — fal.ai 게이트웨이 (키 하나로 서버에서 호출)
# https://fal.ai 가입 → API Keys 에서 발급
FAL_KEY=
FAL_KLING_MODEL=fal-ai/kling-video/v1.6/pro/image-to-video

# (VIDEO_PROVIDER=xai 일 때) 그록/xAI 영상 API
XAI_API_KEY=
XAI_VIDEO_URL=https://api.x.ai/v1/video/generations
XAI_VIDEO_MODEL=grok-video

# (VIDEO_PROVIDER=gemini_veo 일 때) 제미나이 Veo 영상 (Veo 접근권한 필요)
GEMINI_VEO_MODEL=veo-3.0-generate-preview
